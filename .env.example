# =========================================================================
# 🔑 VARIÁVEIS DE AMBIENTE — ExtinControl CRM
# =========================================================================
# 📘 EXPLICAÇÃO PARA LEIGOS:
#    Nosso sistema usa Next.js (não Vite, como sugerido no spec inicial).
#    No Next.js, quando uma variável precisa ficar acessível no
#    NAVEGADOR do usuário (frontend), ela OBRIGATORIAMENTE começa
#    com NEXT_PUBLIC_. Isto é o EQUIVALENTE ao prefixo VITE_ do manual.
#
# 🚨 ⚠️  REGRAS DE SEGURANÇA — NUNCA ESQUEÇA DISSO 👇
#    • A CHAVE "SUPABASE_SERVICE_ROLE_KEY" NUNCA, NUNCA, NUNCA pode
#      começar com NEXT_PUBLIC_ nem VITE_. Ela fica SÓ no servidor
#      e NUNCA vai para o navegador de ninguém.
#    • As chaves "ANON_KEY" podem ir com NEXT_PUBLIC_ porque são
#      seguras e servem só para o básico (o RLS do banco cuida do resto).
# =========================================================================

# ============================================================
# 🌐 F R O N T E N D    (lê no navegador / público — seguro)
#    (equivalente Next.js = VITE_    do manual)
# ============================================================

# URL do seu projeto no Supabase (painel → Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave ANON do Supabase (painel → Settings → API → Project API keys → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-public-aqui

# Nome do Aplicativo (conforme spec: VITE_APP_NAME=ExtinControl)
NEXT_PUBLIC_APP_NAME=ExtinControl
VITE_APP_NAME=ExtinControl

# ============================================================
# 🔒 S E R V I D O R   (SÓ fica no backend — NÃO VAI PRO NAVEGADOR)
#    (sem prefixo NEXT_PUBLIC_ e sem VITE_)
# ============================================================

# ⚠️ Service Role — CHAVE MASTER. CUIDADO MÁXIMO!
# (painel Supabase → Settings → API → Project API keys → service_role)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui